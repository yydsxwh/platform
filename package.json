{
  "name": "@yydsxwh/platform",
  "version": "0.1.0",
  "private": true,
  "description": "公司公共平台服务：Storage / Releases / Catalog / Payments 的模块化单体",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yydsxwh/platform.git"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js --external:@prisma/client --external:.prisma",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^5.22.0",
    "@yydsxwh/shared": "github:yydsxwh/shared#v0.5.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "prisma": "^5.22.0",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  }
}
