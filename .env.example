# platform 环境变量示例。只放占位符，真实密钥不得提交进 Git。
#
# 标记：
#   REQUIRED            启动必须有
#   OPTIONAL            有默认值或该能力未启用时可空
#   STAGING ONLY        预发可用、生产禁止或不应依赖
#   PRODUCTION REQUIRED 上生产前必须换成真实值

# ---- 进程 ----
# REQUIRED
NODE_ENV=development
# OPTIONAL  默认 4000。预发 / 生产建议固定并在 systemd 中声明
PORT=4000

# ---- 数据库 ----
# REQUIRED
# platform 自己的库；模块在逻辑上分区，不与任何产品库共用
# 预发 / 生产不要用开发机上的 SQLite 文件路径
DATABASE_URL="file:./data/platform.db"

# ---- 服务身份 ----
# REQUIRED
# 每个产品一把（可多把以便轮换）token，至少 24 位随机串。
# 格式：clientId:token 或 clientId:token:ai+storage+catalog
# 生成：openssl rand -hex 32
# 禁止全公司共用同一把：一把泄漏不应等于所有产品失守。
# 轮换：同一 clientId 再加一把新 token，切流量后删旧的并重启。
# 吊销：从本变量去掉该 token 并重启。
# 日志不得打印完整 token。
PLATFORM_SERVICE_TOKENS="andyyyds:REPLACE_WITH_RANDOM_TOKEN_32B,softwarelist:REPLACE_WITH_RANDOM_TOKEN_32B"

# ---- Storage ----
# OPTIONAL  开发默认 LOCAL；生产用 ALIYUN_OSS
STORAGE_DEFAULT_PROVIDER=LOCAL
# OPTIONAL
STORAGE_LOCAL_ROOT=./data/files
# OPTIONAL  本地签名 URL 的对外基地址
STORAGE_LOCAL_PUBLIC_BASE_URL=http://127.0.0.1:4000
# OPTIONAL  推荐设置。与 service token 分开，避免轮换 token 时短时 URL 全部失效
STORAGE_LOCAL_SIGNING_KEY=

# PRODUCTION REQUIRED（当 STORAGE_DEFAULT_PROVIDER=ALIYUN_OSS）
# OSS AccessKey 只在 platform 进程。浏览器与产品仓库都不得持有。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# OPTIONAL
OSS_REGION=cn-hongkong
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_ACCELERATE_ENABLED=false

# ---- Payments ----
# OPTIONAL  开发 / 预发；生产若接 webhook 履约则 REQUIRED
PAYMENT_WEBHOOK_SECRET=
# STAGING ONLY  生产必须为 false，启动时也会拒绝
PAYMENT_ALLOW_MOCK=true

# ---- AI ----
# OPTIONAL  未配置则 AI 模块返回 FAILED_PRECONDITION，不影响 /health
# Key 不写在清单里，用 apiKeyEnv 指向另一个环境变量名。
AI_PROVIDERS='[{"id":"dashscope","label":"阿里云百炼","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKeyEnv":"AI_KEY_DASHSCOPE","models":[{"id":"qwen-plus"},{"id":"qwen-vl-max","vision":true}]}]'
# PRODUCTION REQUIRED（若启用 AI）
AI_KEY_DASHSCOPE=
# OPTIONAL
AI_ROUTES='{"translate":["dashscope/qwen-plus"],"vision-ocr":["dashscope/qwen-vl-max"],"general":["dashscope/qwen-plus"]}'
AI_DEFAULT_MODEL=dashscope/qwen-plus
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_MINUTE=60
AI_FAILURE_THRESHOLD=3

# ---- Account 接入（本轮不验签）----
# OPTIONAL / NEEDS_ACCOUNT_INTEGRATION
# 下一轮校验 user assertion 时再填。不要猜测生产值。
ACCOUNT_ISSUER=
ACCOUNT_JWKS_URI=
ACCOUNT_AUDIENCE=
