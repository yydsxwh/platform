// platform 是模块化单体：一个库，模块之间按前缀和外键边界逻辑分区。
// 规模变大后可以按模块拆库，现在不提前微服务化。
//
// 数据所有权：这里只存公共平台数据（文件、版本、产品目录事实、支付记录）。
// 用户身份属于 account，业务数据属于各产品，都不要往这里塞。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// storage
// ---------------------------------------------------------------------------

/// 对象元数据。字节在 OSS / 本地盘，这里只记「是什么、谁的、能不能拿」。
model File {
  id          String   @id
  namespace   String
  /// 对象存储里的完整 key，同一 provider 下唯一
  objectKey   String
  provider    String
  fileName    String
  mimeType    String
  size        Int
  visibility  String
  status      String
  /// 上传方的业务身份；产品接好 account 后应是全局 user sub
  ownerId     String?
  /// 哪个站点传的，用于隔离与配额
  clientId    String
  checksum    String?
  /// 少量标签的 JSON，不承担业务数据职责
  labels      String   @default("{}")
  /// 分片直传期间的 OSS uploadId
  uploadId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  releaseAssets ReleaseAsset[]

  @@unique([provider, objectKey])
  @@index([clientId, namespace, status])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// catalog
// ---------------------------------------------------------------------------

/// 公司产品目录的唯一机器可读来源。运营文案不进这里。
model CatalogProduct {
  id                String   @id
  slug              String   @unique
  name              String
  tagline           String   @default("")
  status            String
  webUrl            String?
  iconUrl           String?
  /// ProductPlatform 列表的 JSON 数组
  supportedPlatforms String  @default("[]")
  /// 关联 Releases 的产品键；不发安装包的产品为空
  releaseProductKey String?
  listed            Boolean  @default(true)
  sortWeight        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, listed])
}

// ---------------------------------------------------------------------------
// releases
// ---------------------------------------------------------------------------

model Release {
  id                String   @id
  productKey        String
  version           String
  channel           String
  status            String
  releasedAt        DateTime?
  changelog         String   @default("")
  minimumUpgradeFrom String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assets ReleaseAsset[]

  @@unique([productKey, channel, version])
  @@index([productKey, channel, status])
}

model ReleaseAsset {
  id           String   @id
  releaseId    String
  fileId       String
  platform     String
  architecture String
  checksum     String?
  labels       String   @default("{}")
  createdAt    DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@unique([releaseId, platform, architecture])
  @@index([fileId])
}

// ---------------------------------------------------------------------------
// payments
// ---------------------------------------------------------------------------

/// 支付单。只管钱怎么付；买了什么、因此拥有什么能力由产品与未来的
/// Billing / Entitlements 表达，不要塞进这里。
model Payment {
  id                    String   @id
  /// 调用方自己的订单号，配合 clientId 做创建幂等
  clientOrderNo         String
  clientId              String
  provider              String
  method                String
  amountCents           Int
  currency              String   @default("CNY")
  subject               String
  status                String
  payerId               String?
  payerOpenId           String?
  providerTransactionId String?
  returnUrl             String?
  paidAt                DateTime?
  expiresAt             DateTime?
  /// 回传给产品用于履约的上下文，platform 原样保存不解释
  metadata              String   @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  refunds Refund[]
  events  PaymentEvent[]

  @@unique([clientId, clientOrderNo])
  @@index([status, createdAt])
  @@index([providerTransactionId])
}

/// 渠道回调的幂等去重表：同一 providerEventId 只处理一次。
model PaymentEvent {
  id              String   @id
  paymentId       String
  provider        String
  /// 渠道侧事件唯一键（微信 transaction_id、支付宝 notify_id 等）
  providerEventId String
  type            String
  payload         String
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

model Refund {
  id            String   @id
  paymentId     String
  clientRefundNo String
  amountCents   Int
  status        String
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, clientRefundNo])
}

// ---------------------------------------------------------------------------
// ai
// ---------------------------------------------------------------------------

/// AI 调用记录：用量、成本与失败分类。
/// 只记元数据，不存提示词与模型输出——那是产品的业务内容，也可能含用户隐私。
model AiUsage {
  id               String   @id
  requestId        String
  clientId         String
  actorId          String?
  purpose          String?
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// 百万分之一元；provider 未配单价时为 0
  costMicros       Int      @default(0)
  latencyMs        Int      @default(0)
  status           String
  errorKind        String?
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([provider, model])
}

/// 运行时可改的 AI Provider 配置。
/// 有这张表之前，换一个模型或补一把 Key 都要改环境变量再重启；
/// 主站后台「系统设置 → AI 接口」需要一个能在线保存的控制面，所以落库。
/// 环境变量仍然有效，作为初始值与兜底；库里有同名 provider 时以库为准。
model AiProviderSetting {
  id        String   @id
  label     String   @default("")
  baseUrl   String
  /// AES-256-GCM 密文，密钥来自 PLATFORM_CONFIG_ENCRYPTION_KEY。
  /// 明文只在拼 Authorization 头时出现在内存里，不出现在任何响应与日志。
  apiKeyCipher String?
  /// JSON 数组：[{id, vision, costPerMillionInputMicros, costPerMillionOutputMicros}]
  models    String   @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 用途 → 候选模型路由。与 AI_ROUTES 同义，只是可在线改。
model AiRouteSetting {
  purpose    String   @id
  /// JSON 数组，按顺序尝试的 `provider/model`
  candidates String   @default("[]")
  updatedAt  DateTime @updatedAt
}
