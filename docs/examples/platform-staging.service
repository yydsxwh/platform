[Unit]
Description=yydsxwh platform staging
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/platform-staging
EnvironmentFile=/var/www/platform-staging/.env
Environment=HOST=127.0.0.1
Environment=PORT=4000
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
